index 76f32e424..0bae889be 100644
--- a/arch/arm64/kernel/Makefile
+++ b/arch/arm64/kernel/Makefile
@@ -77,6 +77,7 @@ $(obj)/vdso32-wrap.o: $(obj)/vdso32/vdso.so
 
 obj-y					+= probes/
 obj-y					+= head.o
+obj-$(CONFIG_QUEST2_DIAG_WDT_BEACON)	+= quest2_wdt_beacon.o
 always-$(KBUILD_BUILTIN)		+= vmlinux.lds
 
 ifeq ($(CONFIG_DEBUG_EFI),y)
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index ca04b338c..bf2f64847 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -35,6 +35,7 @@
 #include <asm/stacktrace/frame.h>
 #include <asm/thread_info.h>
 #include <asm/virt.h>
+#include <asm/quest2_wdt_beacon.h>
 
 #include "efi-header.S"
 
@@ -84,6 +85,25 @@
 	 */
 SYM_CODE_START(primary_entry)
 	bl	record_mmu_state
+#ifdef CONFIG_QUEST2_DIAG_WDT_BEACON
+	/*
+	 * DIAGNOSTIC ONLY, beacon checkpoint C0. Only with the MMU off, since
+	 * the address is physical. x0-x3 hold the boot arguments and x19 is
+	 * in use, so only x9/x10 are touched.
+	 */
+	mrs	x9, sctlr_el1
+	tbnz	x9, #0, 9f
+	mov_q	x9, QUEST2_WDT_BEACON_BASE
+	str	wzr, [x9, #QUEST2_WDT_BEACON_EN]
+	mov_q	x10, QUEST2_WDT_BEACON_TICKS
+	str	w10, [x9, #QUEST2_WDT_BEACON_BARK]
+	str	w10, [x9, #QUEST2_WDT_BEACON_BITE]
+	mov	w10, #1
+	str	w10, [x9, #QUEST2_WDT_BEACON_EN]
+	str	w10, [x9, #QUEST2_WDT_BEACON_RST]
+	dsb	sy
+9:
+#endif
 	bl	preserve_boot_args
 
 	adrp	x1, early_init_stack
diff --git a/arch/arm64/kernel/quest2_wdt_beacon.c b/arch/arm64/kernel/quest2_wdt_beacon.c
new file mode 100644
index 000000000..4a725916f
--- /dev/null
+++ b/arch/arm64/kernel/quest2_wdt_beacon.c
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DIAGNOSTIC ONLY (Oculus Quest 2): checkpoints C1-C4 of the watchdog-timing
+ * beacon, see asm/quest2_wdt_beacon.h. C0 is in head.S. qcom_wdt later finds
+ * the watchdog running and keeps pinging it.
+ */
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/printk.h>
+#include <linux/sizes.h>
+#include <asm/arch_timer.h>
+#include <asm/early_ioremap.h>
+#include <asm/quest2_wdt_beacon.h>
+#include <asm/sysreg.h>
+
+static void __init quest2_wdt_beacon_spin(void)
+{
+	u64 freq = read_sysreg(cntfrq_el0);
+	u64 start, cycles;
+
+	if (!freq)
+		freq = 19200000;	/* sm8250 arch timer (sm8250.dtsi) */
+	cycles = freq * QUEST2_WDT_BEACON_SPIN_S;
+
+	start = __arch_counter_get_cntvct();
+	while (__arch_counter_get_cntvct() - start < cycles)
+		cpu_relax();
+}
+
+static void __init quest2_wdt_beacon_arm(void __iomem *wdt)
+{
+	writel_relaxed(0, wdt + QUEST2_WDT_BEACON_EN);
+	writel_relaxed(QUEST2_WDT_BEACON_TICKS, wdt + QUEST2_WDT_BEACON_BARK);
+	writel_relaxed(QUEST2_WDT_BEACON_TICKS, wdt + QUEST2_WDT_BEACON_BITE);
+	writel_relaxed(1, wdt + QUEST2_WDT_BEACON_EN);
+	writel_relaxed(1, wdt + QUEST2_WDT_BEACON_RST);
+	mb();	/* WDT armed before execution continues */
+}
+
+void __init quest2_wdt_beacon(int checkpoint)
+{
+	void __iomem *wdt;
+
+	quest2_wdt_beacon_spin();
+
+	if (checkpoint == 1) {
+		/* before early_ioremap_reset(); ioremap() is not up yet */
+		wdt = early_ioremap(QUEST2_WDT_BEACON_BASE, SZ_4K);
+		if (!wdt)
+			return;
+		quest2_wdt_beacon_arm(wdt);
+		early_iounmap(wdt, SZ_4K);
+	} else {
+		wdt = ioremap(QUEST2_WDT_BEACON_BASE, SZ_4K);
+		if (!wdt)
+			return;
+		quest2_wdt_beacon_arm(wdt);
+		iounmap(wdt);
+	}
+
+	pr_info("quest2-diag: WDT beacon C%d armed, bite %u.%u s\n",
+		checkpoint, QUEST2_WDT_BEACON_BITE_DS / 10,
+		QUEST2_WDT_BEACON_BITE_DS % 10);
+}
