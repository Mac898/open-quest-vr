new file mode 100644
index 000000000..74f751c7d
--- /dev/null
+++ b/include/linux/quest2_wdt_beacon.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* DIAGNOSTIC ONLY: see arch/arm64/include/asm/quest2_wdt_beacon.h */
+#ifndef __LINUX_QUEST2_WDT_BEACON_H
+#define __LINUX_QUEST2_WDT_BEACON_H
+
+#ifdef CONFIG_QUEST2_DIAG_WDT_BEACON
+#include <asm/quest2_wdt_beacon.h>
+#else
+static inline void quest2_wdt_beacon(int checkpoint) { }
+#endif
+
+#endif /* __LINUX_QUEST2_WDT_BEACON_H */
