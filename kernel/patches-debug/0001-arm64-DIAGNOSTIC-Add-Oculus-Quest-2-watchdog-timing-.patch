diff --git a/arch/arm64/include/asm/quest2_wdt_beacon.h b/arch/arm64/include/asm/quest2_wdt_beacon.h
new file mode 100644
index 000000000..7a4182249
--- /dev/null
+++ b/arch/arm64/include/asm/quest2_wdt_beacon.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DIAGNOSTIC ONLY (Oculus Quest 2).
+ *
+ * Watchdog-timing beacon: early boot checkpoints re-arm the APSS watchdog,
+ * so the time from the kexec handoff to the SoC reset shows the last
+ * checkpoint reached. Checkpoint Ci is armed 21 * i s after the handoff and
+ * a hang after it bites at 21 * i + 31.5 s; the bites fall halfway between
+ * the arm times. The bark interrupt stays off: nothing handles it this
+ * early.
+ */
+#ifndef __ASM_QUEST2_WDT_BEACON_H
+#define __ASM_QUEST2_WDT_BEACON_H
+
+#define QUEST2_WDT_BEACON_BASE		0x17c10000
+#define QUEST2_WDT_BEACON_RST		0x04
+#define QUEST2_WDT_BEACON_EN		0x08
+#define QUEST2_WDT_BEACON_BARK		0x10
+#define QUEST2_WDT_BEACON_BITE		0x14
+
+#define QUEST2_WDT_BEACON_SCLK_HZ	32764
+#define QUEST2_WDT_BEACON_SPIN_S	21
+/* bite 31.5 s: 31.5 * 32764 Hz = 1032066 = 0xfbf82, below the 0xfffff limit */
+#define QUEST2_WDT_BEACON_BITE_DS	315
+#define QUEST2_WDT_BEACON_TICKS		1032066
+
+#ifndef __ASSEMBLY__
+#include <linux/init.h>
+void __init quest2_wdt_beacon(int checkpoint);
+#endif
+
+#endif /* __ASM_QUEST2_WDT_BEACON_H */
