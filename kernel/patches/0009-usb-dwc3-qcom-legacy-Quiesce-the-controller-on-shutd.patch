From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mac <xmachd@gmail.com>
Date: Tue, 20 Oct 2026 12:00:00 +0000
Subject: [PATCH 09/16] usb: dwc3: qcom-legacy: Quiesce the controller on
 shutdown

Without a .shutdown callback the controller keeps running across kexec
and writes events into memory the next kernel may reuse. Use
dwc3_qcom_remove(), as the flattened glue in dwc3-qcom.c does.

Signed-off-by: mac <xmachd@gmail.com>
---
 drivers/usb/dwc3/dwc3-qcom-legacy.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/usb/dwc3/dwc3-qcom-legacy.c b/drivers/usb/dwc3/dwc3-qcom-legacy.c
index d3fad0fcf..e21fed980 100644
--- a/drivers/usb/dwc3/dwc3-qcom-legacy.c
+++ b/drivers/usb/dwc3/dwc3-qcom-legacy.c
@@ -922,6 +922,11 @@ MODULE_DEVICE_TABLE(of, dwc3_qcom_of_match);
 static struct platform_driver dwc3_qcom_driver = {
 	.probe		= dwc3_qcom_probe,
 	.remove		= dwc3_qcom_remove,
+	/*
+	 * Stop the controller before kexec, as the flattened glue does:
+	 * otherwise it keeps writing events into the old kernel's memory.
+	 */
+	.shutdown	= dwc3_qcom_remove,
 	.driver		= {
 		.name	= "dwc3-qcom-legacy",
 		.pm	= &dwc3_qcom_dev_pm_ops,
