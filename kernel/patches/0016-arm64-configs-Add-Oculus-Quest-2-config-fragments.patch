From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mac <xmachd@gmail.com>
Date: Tue, 20 Oct 2026 12:00:00 +0000
Subject: [PATCH 16/16] arm64: configs: Add Oculus Quest 2 config fragments

Add config fragments for the Oculus Quest 2, applied on top of
defconfig in this order:

- quest2.config: a trimmed kernel with everything needed to boot built
  in;
- quest2-iter.config: kexec, and no NVMEM writer modules;
- quest2-gpu.config: the headless GPU stack as modules;
- quest2-smmu.config: arm-smmu built in, for the apps SMMU.

Signed-off-by: mac <xmachd@gmail.com>
---
 arch/arm64/configs/quest2-gpu.config  |  81 +++++++
 arch/arm64/configs/quest2-iter.config |  20 ++
 arch/arm64/configs/quest2-smmu.config |   6 +
 arch/arm64/configs/quest2.config      | 295 ++++++++++++++++++++++++++
 4 files changed, 402 insertions(+)
 create mode 100644 arch/arm64/configs/quest2-gpu.config
 create mode 100644 arch/arm64/configs/quest2-iter.config
 create mode 100644 arch/arm64/configs/quest2-smmu.config
 create mode 100644 arch/arm64/configs/quest2.config

diff --git a/arch/arm64/configs/quest2-gpu.config b/arch/arm64/configs/quest2-gpu.config
new file mode 100644
index 000000000..187e48efd
--- /dev/null
+++ b/arch/arm64/configs/quest2-gpu.config
@@ -0,0 +1,81 @@
+# Oculus Quest 2: headless Adreno 650 as modules, applied after
+# quest2-iter.config. The GPU-side drivers are modules, so nothing
+# GPU-related probes at boot. With DRM=m, PHY_QCOM_QMP_COMBO becomes a module
+# too; its node is disabled.
+CONFIG_DRM=m
+CONFIG_DRM_MSM=m
+# CONFIG_DRM_MSM_MDP4 is not set
+# CONFIG_DRM_MSM_MDP5 is not set
+# CONFIG_DRM_MSM_DPU is not set
+# CONFIG_DRM_MSM_DP is not set
+# CONFIG_DRM_MSM_DSI is not set
+# CONFIG_DRM_MSM_HDMI is not set
+# CONFIG_DRM_MSM_GPU_SUDO is not set
+# CONFIG_DRM_FBDEV_EMULATION is not set
+# gpucc (GPU GDSCs, GMU clocks)
+CONFIG_SM_GPUCC_8250=m
+# adreno_smmu; quest2-smmu.config overrides this with =y
+CONFIG_ARM_SMMU=m
+# qfprom (GPU speed bin): built in because QCOM_TSENS depends on it.
+# Read-only with a single reg region.
+CONFIG_NVMEM_QCOM_QFPROM=y
+# No nvmem sysfs files: reading the whole qfprom window touches
+# read-protected fuse rows
+# CONFIG_NVMEM_SYSFS is not set
+#
+# DRM drivers that cannot bind on SM8250
+# CONFIG_DRM_NOUVEAU is not set
+# CONFIG_DRM_TEGRA is not set
+# CONFIG_DRM_ROCKCHIP is not set
+# CONFIG_DRM_EXYNOS is not set
+# CONFIG_DRM_RCAR_DU is not set
+# CONFIG_DRM_RZG2L_DU is not set
+# CONFIG_DRM_SUN4I is not set
+# CONFIG_DRM_MESON is not set
+# CONFIG_DRM_HISI_HIBMC is not set
+# CONFIG_DRM_HISI_KIRIN is not set
+# CONFIG_DRM_MEDIATEK is not set
+# CONFIG_DRM_IMX_DCSS is not set
+# CONFIG_DRM_IMX_LCDIF is not set
+# CONFIG_DRM_ETNAVIV is not set
+# CONFIG_DRM_PANFROST is not set
+# CONFIG_DRM_PANTHOR is not set
+# CONFIG_DRM_LIMA is not set
+# CONFIG_DRM_V3D is not set
+# CONFIG_DRM_VC4 is not set
+# CONFIG_DRM_MALI_DISPLAY is not set
+# CONFIG_DRM_KOMEDA is not set
+# CONFIG_DRM_ZYNQMP_DPSUB is not set
+# CONFIG_DRM_TIDSS is not set
+# CONFIG_DRM_POWERVR is not set
+# CONFIG_DRM_AMDGPU is not set
+# CONFIG_DRM_RADEON is not set
+# CONFIG_DRM_AST is not set
+# CONFIG_DRM_QXL is not set
+# CONFIG_DRM_VIRTIO_GPU is not set
+# CONFIG_DRM_I2C_NXP_TDA998X is not set
+# CONFIG_DRM_SIMPLEDRM is not set
+# CONFIG_DRM_DISPLAY_CONNECTOR is not set
+#
+# No module that writes fuses, PMIC NVM, charger configuration or persistent
+# storage, or maps secure carveouts
+# pm8150b charger block OTG/VBUS switch (charger configuration):
+# CONFIG_REGULATOR_QCOM_USB_VBUS is not set
+# Google MAX77759 charger/fuel-gauge PMIC and its NVMEM writer:
+# CONFIG_MFD_MAX77759 is not set
+# CONFIG_NVMEM_MAX77759 is not set
+# CONFIG_GPIO_MAX77759 is not set
+# I2C/SPI EEPROM writers (persistent storage; they also select NVMEM_SYSFS):
+# CONFIG_EEPROM_AT24 is not set
+# CONFIG_EEPROM_AT25 is not set
+# Reserved-memory exposed as nvmem (a read could hit a secure carveout):
+# CONFIG_NVMEM_RMEM is not set
+# Modem remote-FS carveout: SCM hyp-assign + userspace storage writes:
+# CONFIG_QCOM_RMTFS_MEM is not set
+# TI TPS6594 PMIC FSM/ESM user interface (PMIC state programming):
+# CONFIG_TPS6594_PFSM is not set
+# CONFIG_TPS6594_ESM is not set
+# PMIC PON watchdog (reset configuration in the PON block):
+# CONFIG_PM8916_WATCHDOG is not set
+# USB mass-storage gadget (exports block devices/files to the host):
+# CONFIG_USB_MASS_STORAGE is not set
diff --git a/arch/arm64/configs/quest2-iter.config b/arch/arm64/configs/quest2-iter.config
new file mode 100644
index 000000000..96f317426
--- /dev/null
+++ b/arch/arm64/configs/quest2-iter.config
@@ -0,0 +1,20 @@
+# Oculus Quest 2: kexec and modules, applied after quest2.config.
+#
+# kexec_file_load reuses the running kernel's FDT, including the reserved
+# memory the boot loader added. KEXEC needs PM_SLEEP_SMP and so SUSPEND,
+# which only builds the system-sleep code.
+CONFIG_SUSPEND=y
+# CONFIG_PM_AUTOSLEEP is not set
+# CONFIG_PM_WAKELOCKS is not set
+# CONFIG_PM_DEBUG is not set
+CONFIG_HOTPLUG_CPU=y
+CONFIG_KEXEC=y
+CONFIG_KEXEC_FILE=y
+# CONFIG_KEXEC_SIG is not set
+# CONFIG_KEXEC_JUMP is not set
+# CONFIG_KEXEC_HANDOVER is not set
+# CONFIG_CRASH_DUMP is not set
+#
+# NVMEM writers (PMIC SDAM, secure QFPROM) stay out of the module set
+# CONFIG_NVMEM_SPMI_SDAM is not set
+# CONFIG_NVMEM_QCOM_SEC_QFPROM is not set
diff --git a/arch/arm64/configs/quest2-smmu.config b/arch/arm64/configs/quest2-smmu.config
new file mode 100644
index 000000000..926311976
--- /dev/null
+++ b/arch/arm64/configs/quest2-smmu.config
@@ -0,0 +1,6 @@
+# Oculus Quest 2, applied last: arm-smmu built in, so that the apps SMMU
+# binds in inherit mode before USB and QUP2 probe.
+#
+# adreno_smmu then probes at boot too; without gpucc loaded it defers and
+# fails at the deferred-probe timeout without touching the hardware.
+CONFIG_ARM_SMMU=y
diff --git a/arch/arm64/configs/quest2.config b/arch/arm64/configs/quest2.config
