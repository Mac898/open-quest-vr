+
+# No /dev/mem: no-map carveouts are not System RAM, so it would allow reads
+# of secure memory, which hang the device.
+# No /dev/i2c-*: GENI I2C uses SE DMA for 32 bytes or more, on a stream
+# Android left translating. bq27xxx only makes short FIFO reads.
+# CONFIG_I2C_CHARDEV is not set
+# CONFIG_DEVMEM is not set
+# No PMIC reboot-reason writes
+# CONFIG_POWER_RESET_QCOM_PON is not set
+# CONFIG_NVMEM_REBOOT_MODE is not set
+
+# syncboss MCU on QUP2 SE19. No spidev: the driver's command allowlist is
+# the only path to the MCU.
+CONFIG_SPI_QCOM_GENI=y
+CONFIG_QUEST2_SYNCBOSS=y
