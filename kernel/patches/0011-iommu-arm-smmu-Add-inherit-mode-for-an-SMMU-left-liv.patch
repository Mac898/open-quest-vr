 		udelay(delay);
 	}
 
+	/* Inherit mode (Quest 2 apps SMMU): say so, as arm-smmu.c does */
+	if (smmu->inherit)
+		dev_err_ratelimited(smmu->dev,
+				    "TLB sync timed out -- SMMU may be deadlocked\n");
 	qcom_smmu_tlb_sync_debug(smmu);
 }
 
@@ -424,6 +428,13 @@ static int qcom_smmu_cfg_probe(struct arm_smmu_device *smmu)
 	u32 smr;
 	int i;
 
+	/*
+	 * Inherit mode (Quest 2 apps SMMU) never runs this: the quirk probe
+	 * below writes an S2CR of type BYPASS and programs a context bank.
+	 */
+	if (WARN_ON(smmu->inherit))
