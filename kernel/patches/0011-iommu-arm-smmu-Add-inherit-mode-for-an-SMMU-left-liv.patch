-	 * with that, so until ARM gets converted to rely on groups and default
-	 * domains, just say no (but more politely than by dereferencing NULL).
-	 * This should be at least a WARN_ON once that's sorted.
-	 */
-	cfg = dev_iommu_priv_get(dev);
-	if (!cfg)
-		return -ENODEV;
+	/* Inherit mode: no attach without a live allowlist */
+	if (smmu->inherit && !smmu->inherit_attach)
+		return -EPERM;
 
-	smmu = cfg->smmu;
+	if (smmu->inherit) {
+		writes = atomic_read(&smmu->inherit_writes);
+		refused = atomic_read(&smmu->inherit_refused);
+	}
 
 	ret = arm_smmu_rpm_get(smmu);
 	if (ret < 0)
@@ -1204,14 +1293,51 @@ static int arm_smmu_attach_dev(struct iommu_domain *domain, struct device *dev)
 		goto rpm_put;
 	}
 
+	/*
+	 * Inherit mode: no global TLB invalidation ran at probe. Invalidate
+	 * the domain's ASID on its own bank before a stream points at it.
+	 */
+	if (smmu->inherit)
+		smmu_domain->flush_ops->tlb_flush_all(smmu_domain);
+
 	/* Looks ok, so add the device to the domain */
 	arm_smmu_master_install_s2crs(cfg, S2CR_TYPE_TRANS,
 				      smmu_domain->cfg.cbndx, fwspec);
 rpm_put:
 	arm_smmu_rpm_put(smmu);
+	if (smmu->inherit) {
+		writes = atomic_read(&smmu->inherit_writes) - writes;
+		refused = atomic_read(&smmu->inherit_refused) - refused;
+		if (ret)
+			dev_info(dev, "inherit: attach failed (%d), %d register writes, %d refused\n",
+				 ret, writes, refused);
+		else
+			dev_info(dev, "inherit: attached to CB%u, %d register writes, %d refused\n",
+				 smmu_domain->cfg.cbndx, writes, refused);
