diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu.c b/drivers/iommu/arm/arm-smmu/arm-smmu.c
index 488632b8e..d9deca5f7 100644
--- a/drivers/iommu/arm/arm-smmu/arm-smmu.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu.c
@@ -69,6 +69,32 @@ MODULE_PARM_DESC(disable_bypass,
 
 static bool using_legacy_binding, using_generic_binding;
 
+/*
+ * Inherit mode, for an SMMU that is live when this kernel starts (the Oculus
+ * Quest 2 apps SMMU after kexec from Android). Some of its stream map entries
+ * and context banks belong to the secure world, and the storage streams depend
+ * on its global configuration, so it is never reset. The probe only reads the
+ * stream map and marks every valid entry, and every bank one points at, as in
+ * use.
+ *
+ * A master may attach only if its stream ID is in oculus,inherit-attach-sids
+ * and an inherited entry matches exactly that ID with mask 0. It takes that
+ * entry over and gets a free context bank; the old bank stays reserved.
+ *
+ * Every register access goes through arm_smmu_inherit_access_ok().
+ */
+static bool arm_smmu_inherit_sid_allowed(struct arm_smmu_device *smmu, u16 sid)
+{
+	int i;
+
+	for (i = 0; i < smmu->num_inherit_sids; i++)
+		if (smmu->inherit_sids[i] == sid)
+			return true;
+	return false;
+}
+
+static int arm_smmu_inherit_dump(struct arm_smmu_device *smmu, const char *tag);
+
 static inline int arm_smmu_rpm_get(struct arm_smmu_device *smmu)
 {
 	if (pm_runtime_enabled(smmu->dev))
@@ -801,6 +827,9 @@ static int arm_smmu_init_domain_context(struct arm_smmu_domain *smmu_domain,
 
 	if (smmu_domain->stage == ARM_SMMU_DOMAIN_S2)
 		cfg->vmid = cfg->cbndx + 1;
+	else if (smmu->inherit)
+		/* above every inherited ASID: no TLB entry shared with them */
+		cfg->asid = ARM_SMMU_INHERIT_ASID_BASE + cfg->cbndx;
 	else
 		cfg->asid = cfg->cbndx;
 
@@ -840,6 +869,14 @@ static int arm_smmu_init_domain_context(struct arm_smmu_domain *smmu_domain,
 
 	domain->geometry.force_aperture = true;
 
+	/*
+	 * Inherit mode: nothing reset this bank. Clear any stale fault status
+	 * before its fault interrupt is enabled.
+	 */
+	if (smmu->inherit)
+		arm_smmu_cb_write(smmu, cfg->cbndx, ARM_SMMU_CB_FSR,
+				  ARM_SMMU_CB_FSR_FAULT);
+
 	/* Initialise the context bank with our page table cfg */
 	arm_smmu_init_context_bank(smmu_domain, &pgtbl_cfg);
 	arm_smmu_write_context_bank(smmu, cfg->cbndx);
@@ -997,7 +1034,7 @@ static void arm_smmu_test_smr_masks(struct arm_smmu_device *smmu)
 	u32 smr;
 	int i;
 
-	if (!smmu->smrs)
+	if (!smmu->smrs || WARN_ON(smmu->inherit))
 		return;
 	/*
 	 * If we've had to accommodate firmware memory regions, we may
@@ -1056,8 +1093,17 @@ static int arm_smmu_find_sme(struct arm_smmu_device *smmu, u16 id, u16 mask)
 		 * no harm in accommodating the generalisation.
 		 */
 		if ((mask & smrs[i].mask) == mask &&
-		    !((id ^ smrs[i].id) & ~smrs[i].mask))
+		    !((id ^ smrs[i].id) & ~smrs[i].mask)) {
+			/*
+			 * Inherit mode: an inherited entry is only taken over
+			 * by a master with exactly its ID and no mask, so no
+			 * other stream it matches is re-pointed.
+			 */
+			if (smmu->inherit && test_bit(i, smmu->inherit_smes) &&
+			    (smrs[i].mask || mask || smrs[i].id != id))
+				return -EPERM;
 			return i;
+		}
 		/*
 		 * If the new entry has any other overlap with an existing one,
 		 * though, then there always exists at least one stream ID
@@ -1067,11 +1113,37 @@ static int arm_smmu_find_sme(struct arm_smmu_device *smmu, u16 id, u16 mask)
 			return -EINVAL;
 	}
 
+	/*
+	 * Inherit mode: a master only takes over an inherited entry. It never
+	 * claims a free one, which would add a stream match for an ID the
+	 * previous OS left unmatched.
+	 */
+	if (smmu->inherit) {
+		dev_err(smmu->dev, "inherit: no inherited stream map entry for ID %#x mask %#x\n",
+			id, mask);
+		return -EPERM;
+	}
+
 	return free_idx;
 }
 
 static bool arm_smmu_free_sme(struct arm_smmu_device *smmu, int idx)
 {
+	/*
+	 * Inherit mode: stream map entries stay pinned. Releasing one would
+	 * write an S2CR of type FAULT or BYPASS and invalidate its SMR.
+	 */
+	if (smmu->inherit) {
+		/*
+		 * Every entry keeps the reference the probe seeded. When the
+		 * last master lets go, forget its group, which the core frees
+		 * with that master; a later master gets a new one.
+		 */
+		if (smmu->s2crs[idx].count > 1 && --smmu->s2crs[idx].count == 1)
+			smmu->s2crs[idx].group = NULL;
+		return false;
+	}
+
 	if (--smmu->s2crs[idx].count)
 		return false;
 
@@ -1106,6 +1178,9 @@ static int arm_smmu_master_alloc_smes(struct device *dev)
 			goto out_err;
 
 		idx = ret;
+		if (smmu->inherit && test_and_clear_bit(idx, smmu->inherit_smes))
+			dev_info(dev, "inherit: taking over SME %d (SID %#x), its CB%u stays reserved\n",
+				 idx, sid, smmu->s2crs[idx].cbndx);
 		if (smrs && smmu->s2crs[idx].count == 0) {
 			smrs[idx].id = sid;
 			smrs[idx].mask = mask;
@@ -1115,9 +1190,13 @@ static int arm_smmu_master_alloc_smes(struct device *dev)
 		cfg->smendx[i] = (s16)idx;
 	}
 
-	/* It worked! Now, poke the actual hardware */
-	for_each_cfg_sme(cfg, fwspec, i, idx)
-		arm_smmu_write_sme(smmu, idx);
+	/*
+	 * It worked! Now, poke the actual hardware. Inherit mode writes the
+	 * entry only at attach, once its bank is programmed.
+	 */
+	if (!smmu->inherit)
+		for_each_cfg_sme(cfg, fwspec, i, idx)
+			arm_smmu_write_sme(smmu, idx);
 
 	mutex_unlock(&smmu->stream_map_mutex);
 	return 0;
@@ -1152,6 +1231,7 @@ static void arm_smmu_master_install_s2crs(struct arm_smmu_master_cfg *cfg,
 {
 	struct arm_smmu_device *smmu = cfg->smmu;
 	struct arm_smmu_s2cr *s2cr = smmu->s2crs;
+	bool written = false;
 	int i, idx;
 
 	for_each_cfg_sme(cfg, fwspec, i, idx) {
@@ -1161,30 +1241,39 @@ static void arm_smmu_master_install_s2crs(struct arm_smmu_master_cfg *cfg,
 		s2cr[idx].type = type;
 		s2cr[idx].privcfg = S2CR_PRIVCFG_DEFAULT;
 		s2cr[idx].cbndx = cbndx;
-		arm_smmu_write_s2cr(smmu, idx);
+		if (smmu->inherit)
+			arm_smmu_write_sme(smmu, idx);
+		else
+			arm_smmu_write_s2cr(smmu, idx);
+		written = true;
 	}
+
+	if (smmu->inherit && written)
+		arm_smmu_inherit_dump(smmu, "attach");
 }
 
-static int arm_smmu_attach_dev(struct iommu_domain *domain, struct device *dev)
+/*
+ * Finalise the domain on its context bank and point the master's stream map
+ * entries at it. In inherit mode the bank is fully programmed and its ASID
+ * invalidated before the S2CR, then the SMR, is written, and the number of
