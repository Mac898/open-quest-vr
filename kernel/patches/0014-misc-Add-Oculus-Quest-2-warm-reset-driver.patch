 drivers/misc/Makefile                  |   2 +
 drivers/misc/quest2-warm-reset-stall.h | 125 +++++
 drivers/misc/quest2-warm-reset-test.c  | 192 ++++++++
 drivers/misc/quest2-warm-reset.c       | 612 +++++++++++++++++++++++++
 5 files changed, 955 insertions(+)
 create mode 100644 drivers/misc/quest2-warm-reset-stall.h
