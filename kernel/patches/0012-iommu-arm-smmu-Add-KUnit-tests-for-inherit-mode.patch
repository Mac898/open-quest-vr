+/* Release keeps the seeded reference and forgets the freed group */
+static void inherit_free_sme_keeps_pin(struct kunit *test)
+{
+	struct arm_smmu_device *smmu = t_smmu(test, true);
+	struct arm_smmu_s2cr *s2crs = kunit_kcalloc(test, T_GROUPS, sizeof(*s2crs),
+						    GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, s2crs);
+	smmu->s2crs = s2crs;
+	s2crs[T_USB_SME].count = 2;
+	s2crs[T_USB_SME].group = (struct iommu_group *)test;
+	KUNIT_EXPECT_FALSE(test, arm_smmu_inherit_test_free_sme(smmu, T_USB_SME));
+	KUNIT_EXPECT_EQ(test, s2crs[T_USB_SME].count, 1);
+	KUNIT_EXPECT_NULL(test, s2crs[T_USB_SME].group);
+	KUNIT_EXPECT_FALSE(test, arm_smmu_inherit_test_free_sme(smmu, T_USB_SME));
+	KUNIT_EXPECT_EQ(test, s2crs[T_USB_SME].count, 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_writes), 0);
+}
+
+#define T_ID2		0x1522	/* AArch64 4K tables, 48-bit VA, 40-bit IPA/PA */
+#define T_NEW_CB	1	/* the first bank the fake window leaves free */
+
+/* The probe-time state with the allowlist <0>, as dt_probe sets it up */
+static struct arm_smmu_device *t_attach_smmu(struct kunit *test, struct t_win *w)
+{
+	static u32 sid;
+	struct arm_smmu_device *smmu = t_probe_smmu(test, w, T_ID0, T_ID1);
+	int i;
+
+	t_w32(w->buf, ARM_SMMU_GR0_ID2, T_ID2);
+	memcpy(w->copy, w->buf, T_WIN);
+	smmu->inherit_sids = &sid;
+	smmu->num_inherit_sids = 1;
+	smmu->inherit_attach = true;
+	/* no table-walk cache maintenance: the test device has no DMA ops */
+	smmu->features |= ARM_SMMU_FEAT_COHERENT_WALK;
+	smmu->irqs = kunit_kcalloc(test, 96, sizeof(*smmu->irqs), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, smmu->irqs);
+	for (i = 0; i < 96; i++)
+		smmu->irqs[i] = IRQ_NOTCONNECTED;
+	KUNIT_ASSERT_EQ(test, arm_smmu_inherit_test_cfg_probe(smmu), 0);
+	KUNIT_ASSERT_EQ(test, memcmp(w->buf, w->copy, T_WIN), 0);
+	return smmu;
+}
+
+static u32 t_r32(void *buf, unsigned long off)
+{
+	return *(u32 *)(buf + off);
+}
+
+/* Changed words other than SME 10's S2CR, the bank's CBAR/CBA2R and its page */
+static int t_changed_outside(struct kunit *test, struct t_win *w, unsigned int cb)
+{
+	unsigned long off, cbpage = (unsigned long)(T_NPAGE + cb) << 12;
+	int n = 0;
+
+	for (off = 0; off < T_WIN; off += 4) {
+		if (t_r32(w->buf, off) == t_r32(w->copy, off))
+			continue;
+		if (off == ARM_SMMU_GR0_S2CR(10) ||
+		    off == (1 << 12) + ARM_SMMU_GR1_CBAR(cb) ||
+		    off == (1 << 12) + ARM_SMMU_GR1_CBA2R(cb) ||
+		    (off >= cbpage && off < cbpage + (1 << 12)))
+			continue;
+		kunit_info(test, "unexpected change at %#lx: %#x -> %#x", off,
+			   t_r32(w->copy, off), t_r32(w->buf, off));
+		n++;
+	}
+	return n;
+}
+
+static void inherit_attach_writes_only_its_entry_and_bank(struct kunit *test)
+{
+	struct t_win *w = kunit_kzalloc(test, sizeof(*w), GFP_KERNEL);
+	unsigned long cbpage = (unsigned long)(T_NPAGE + T_NEW_CB) << 12;
+	unsigned long cb15 = (unsigned long)(T_NPAGE + 15) << 12;
+	struct arm_smmu_device *smmu;
+	struct iommu_domain *domain;
+	struct device *dev;
+	u64 ttbr0;
+	int err;
+
+	KUNIT_ASSERT_NOT_NULL(test, w);
+	smmu = t_attach_smmu(test, w);
+	dev = kunit_device_register(test, "arm-smmu-inherit-master");
+	KUNIT_ASSERT_FALSE(test, IS_ERR(dev));
+
+	domain = arm_smmu_inherit_test_attach(smmu, dev, 0, &err);
+	KUNIT_ASSERT_EQ(test, err, 0);
+	KUNIT_ASSERT_NOT_NULL(test, domain);
+
+	KUNIT_EXPECT_EQ(test, t_changed_outside(test, w, T_NEW_CB), 0);
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_refused), 0);
+	KUNIT_EXPECT_GT(test, atomic_read(&smmu->inherit_writes), 0);
+	/* the entry: TRANS to the new bank; its SMR rewritten with the same value */
+	KUNIT_EXPECT_EQ(test, t_r32(w->buf, ARM_SMMU_GR0_S2CR(10)),
+			t_s2cr(S2CR_TYPE_TRANS, T_NEW_CB));
+	KUNIT_EXPECT_EQ(test, t_r32(w->buf, ARM_SMMU_GR0_SMR(10)), t_smr(0, 0));
+	/* the new bank: stage 1, translating, ASID above the inherited ones */
+	KUNIT_EXPECT_EQ(test, FIELD_GET(ARM_SMMU_CBAR_TYPE,
+					t_r32(w->buf, (1 << 12) + ARM_SMMU_GR1_CBAR(T_NEW_CB))),
+			CBAR_TYPE_S1_TRANS_S2_BYPASS);
+	KUNIT_EXPECT_TRUE(test, t_r32(w->buf, cbpage + ARM_SMMU_CB_SCTLR) & ARM_SMMU_SCTLR_M);
+	ttbr0 = (u64)t_r32(w->buf, cbpage + ARM_SMMU_CB_TTBR0 + 4) << 32 |
+		t_r32(w->buf, cbpage + ARM_SMMU_CB_TTBR0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(ARM_SMMU_TTBRn_ASID, ttbr0),
+			ARM_SMMU_INHERIT_ASID_BASE + T_NEW_CB);
+	KUNIT_EXPECT_EQ(test, t_r32(w->buf, cbpage + ARM_SMMU_CB_S1_TLBIASID),
+			ARM_SMMU_INHERIT_ASID_BASE + T_NEW_CB);
+	/* the old bank: reserved, untouched */
+	KUNIT_EXPECT_EQ(test, memcmp(w->buf + cb15, w->copy + cb15, 1 << 12), 0);
+	KUNIT_EXPECT_TRUE(test, test_bit(15, smmu->context_map));
+	KUNIT_EXPECT_TRUE(test, test_bit(15, smmu->inherit_cbs));
+	KUNIT_EXPECT_FALSE(test, test_bit(10, smmu->inherit_smes));
+	KUNIT_EXPECT_EQ(test, smmu->s2crs[10].count, 2);
+
+	/* release: no stream map write; the bank is disabled (SCTLR 0) and freed */
+	memcpy(w->copy, w->buf, T_WIN);
+	arm_smmu_inherit_test_detach(dev, domain);
+	KUNIT_EXPECT_EQ(test, t_changed_outside(test, w, T_NEW_CB), 0);
+	KUNIT_EXPECT_EQ(test, t_r32(w->buf, ARM_SMMU_GR0_S2CR(10)),
+			t_s2cr(S2CR_TYPE_TRANS, T_NEW_CB));
+	KUNIT_EXPECT_EQ(test, t_r32(w->buf, cbpage + ARM_SMMU_CB_SCTLR), 0);
+	KUNIT_EXPECT_FALSE(test, test_bit(T_NEW_CB, smmu->context_map));
+	KUNIT_EXPECT_EQ(test, smmu->s2crs[10].count, 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_refused), 0);
+
+	/* a later master with the same ID gets the same bank back, translating */
+	memcpy(w->copy, w->buf, T_WIN);
+	domain = arm_smmu_inherit_test_attach(smmu, dev, 0, &err);
+	KUNIT_ASSERT_EQ(test, err, 0);
+	KUNIT_EXPECT_EQ(test, t_changed_outside(test, w, T_NEW_CB), 0);
+	KUNIT_EXPECT_TRUE(test, t_r32(w->buf, cbpage + ARM_SMMU_CB_SCTLR) & ARM_SMMU_SCTLR_M);
+	KUNIT_EXPECT_EQ(test, t_r32(w->buf, ARM_SMMU_GR0_S2CR(10)),
+			t_s2cr(S2CR_TYPE_TRANS, T_NEW_CB));
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_refused), 0);
+	arm_smmu_inherit_test_detach(dev, domain);
+}
+
+/* Attach disabled (as after an ASID clash at probe): nothing is written */
+static void inherit_attach_refused_writes_nothing(struct kunit *test)
+{
+	struct t_win *w = kunit_kzalloc(test, sizeof(*w), GFP_KERNEL);
+	struct arm_smmu_device *smmu;
+	struct iommu_domain *domain;
+	struct device *dev;
+	int err;
+
+	KUNIT_ASSERT_NOT_NULL(test, w);
+	smmu = t_attach_smmu(test, w);
+	smmu->inherit_attach = false;
+	dev = kunit_device_register(test, "arm-smmu-inherit-refused");
+	KUNIT_ASSERT_FALSE(test, IS_ERR(dev));
+
+	domain = arm_smmu_inherit_test_attach(smmu, dev, 0, &err);
+	KUNIT_EXPECT_EQ(test, err, -EPERM);
+	arm_smmu_inherit_test_detach(dev, domain);
+	KUNIT_EXPECT_EQ(test, memcmp(w->buf, w->copy, T_WIN), 0);
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_writes), 0);
+}
+
+/*
+ * Two masters on the allowlist <0x63 0x0>, as in the board DT. SME 7 (ID 0x63,
+ * mask 0) on CB7 is added before the probe. Each attach takes over its own
+ * entry, gets a new bank and makes 14 register writes; CB7 and CB15 stay
+ * reserved and untouched.
+ */
+#define T_QUP_SME	7
+#define T_QUP_SID	0x63
+
+static int t_attach_counted(struct kunit *test, struct arm_smmu_device *smmu,
+			    struct device *dev, u32 sid, struct iommu_domain **domain)
+{
+	int w = atomic_read(&smmu->inherit_writes);
+	int err;
+
+	*domain = arm_smmu_inherit_test_attach(smmu, dev, sid, &err);
+	KUNIT_EXPECT_EQ(test, err, 0);
+	return atomic_read(&smmu->inherit_writes) - w;
+}
+
+static void inherit_attach_two_sids(struct kunit *test)
+{
+	static u32 sids[] = { T_QUP_SID, 0x0 };
+	struct t_win *w = kunit_kzalloc(test, sizeof(*w), GFP_KERNEL);
+	unsigned long cb7 = (unsigned long)(T_NPAGE + 7) << 12;
+	unsigned long cb15 = (unsigned long)(T_NPAGE + 15) << 12;
+	struct iommu_domain *dq, *du;
+	struct device *qup, *usb;
+	struct arm_smmu_device *smmu;
+	unsigned int cbq, cbu, i;
+	unsigned long off;
+	int n;
+
+	KUNIT_ASSERT_NOT_NULL(test, w);
+	smmu = t_probe_smmu(test, w, T_ID0, T_ID1);
+	t_w32(w->buf, ARM_SMMU_GR0_ID2, T_ID2);
+	t_w32(w->buf, ARM_SMMU_GR0_SMR(T_QUP_SME), t_smr(T_QUP_SID, 0));
+	t_w32(w->buf, ARM_SMMU_GR0_S2CR(T_QUP_SME), t_s2cr(S2CR_TYPE_TRANS, 7) | 0x300);
+	t_w32(w->buf, cb7 + ARM_SMMU_CB_SCTLR, 1);
+	t_w32(w->buf, cb7 + ARM_SMMU_CB_TTBR0, 0xeb4e4000);
+	t_w32(w->buf, cb7 + ARM_SMMU_CB_TTBR0 + 4, 8 << 16 | 0x1);
+	memcpy(w->copy, w->buf, T_WIN);
+	smmu->inherit_sids = sids;
+	smmu->num_inherit_sids = ARRAY_SIZE(sids);
+	smmu->inherit_attach = true;
+	smmu->features |= ARM_SMMU_FEAT_COHERENT_WALK;
+	smmu->irqs = kunit_kcalloc(test, 96, sizeof(*smmu->irqs), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, smmu->irqs);
+	for (i = 0; i < 96; i++)
+		smmu->irqs[i] = IRQ_NOTCONNECTED;
+	KUNIT_ASSERT_EQ(test, arm_smmu_inherit_test_cfg_probe(smmu), 0);
+	KUNIT_ASSERT_EQ(test, memcmp(w->buf, w->copy, T_WIN), 0);
+	KUNIT_ASSERT_TRUE(test, test_bit(7, smmu->inherit_cbs));
+
+	qup = kunit_device_register(test, "arm-smmu-inherit-qup");
+	usb = kunit_device_register(test, "arm-smmu-inherit-usb");
+	KUNIT_ASSERT_FALSE(test, IS_ERR(qup));
+	KUNIT_ASSERT_FALSE(test, IS_ERR(usb));
+
+	KUNIT_EXPECT_EQ(test, t_attach_counted(test, smmu, qup, T_QUP_SID, &dq), 14);
+	KUNIT_EXPECT_EQ(test, t_attach_counted(test, smmu, usb, 0x0, &du), 14);
+	KUNIT_ASSERT_NOT_NULL(test, dq);
+	KUNIT_ASSERT_NOT_NULL(test, du);
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_refused), 0);
+
+	cbq = FIELD_GET(ARM_SMMU_S2CR_CBNDX, t_r32(w->buf, ARM_SMMU_GR0_S2CR(T_QUP_SME)));
+	cbu = FIELD_GET(ARM_SMMU_S2CR_CBNDX, t_r32(w->buf, ARM_SMMU_GR0_S2CR(T_USB_SME)));
+	KUNIT_EXPECT_NE(test, cbq, cbu);
+	KUNIT_EXPECT_EQ(test, t_r32(w->buf, ARM_SMMU_GR0_S2CR(T_QUP_SME)),
+			t_s2cr(S2CR_TYPE_TRANS, cbq));
+	KUNIT_EXPECT_EQ(test, t_r32(w->buf, ARM_SMMU_GR0_S2CR(T_USB_SME)),
+			t_s2cr(S2CR_TYPE_TRANS, cbu));
+	KUNIT_EXPECT_EQ(test, t_r32(w->buf, ARM_SMMU_GR0_SMR(T_QUP_SME)),
+			t_smr(T_QUP_SID, 0));
+	KUNIT_EXPECT_EQ(test, t_r32(w->buf, ARM_SMMU_GR0_SMR(T_USB_SME)), t_smr(0, 0));
+	/* both new banks were free at probe: neither inherited nor referenced */
+	KUNIT_EXPECT_FALSE(test, test_bit(cbq, smmu->inherit_cbs));
+	KUNIT_EXPECT_FALSE(test, test_bit(cbu, smmu->inherit_cbs));
+	KUNIT_EXPECT_TRUE(test, t_r32(w->buf, ((T_NPAGE + cbq) << 12) + ARM_SMMU_CB_SCTLR) &
+				ARM_SMMU_SCTLR_M);
+	KUNIT_EXPECT_TRUE(test, t_r32(w->buf, ((T_NPAGE + cbu) << 12) + ARM_SMMU_CB_SCTLR) &
+				ARM_SMMU_SCTLR_M);
+
+	/* changed words: the two S2CRs, the two banks' CBAR/CBA2R and pages only */
+	n = 0;
+	for (off = 0; off < T_WIN; off += 4) {
+		unsigned long pq = (unsigned long)(T_NPAGE + cbq) << 12;
+		unsigned long pu = (unsigned long)(T_NPAGE + cbu) << 12;
+
+		if (t_r32(w->buf, off) == t_r32(w->copy, off))
+			continue;
+		if (off == ARM_SMMU_GR0_S2CR(T_QUP_SME) || off == ARM_SMMU_GR0_S2CR(T_USB_SME) ||
+		    off == (1 << 12) + ARM_SMMU_GR1_CBAR(cbq) ||
+		    off == (1 << 12) + ARM_SMMU_GR1_CBA2R(cbq) ||
+		    off == (1 << 12) + ARM_SMMU_GR1_CBAR(cbu) ||
+		    off == (1 << 12) + ARM_SMMU_GR1_CBA2R(cbu) ||
+		    (off >= pq && off < pq + (1 << 12)) ||
+		    (off >= pu && off < pu + (1 << 12)))
+			continue;
+		kunit_info(test, "unexpected change at %#lx: %#x -> %#x", off,
+			   t_r32(w->copy, off), t_r32(w->buf, off));
+		n++;
+	}
+	KUNIT_EXPECT_EQ(test, n, 0);
+
+	/* the old banks: reserved, untouched, referenced by no valid SMR */
+	KUNIT_EXPECT_EQ(test, memcmp(w->buf + cb7, w->copy + cb7, 1 << 12), 0);
+	KUNIT_EXPECT_EQ(test, memcmp(w->buf + cb15, w->copy + cb15, 1 << 12), 0);
+	KUNIT_EXPECT_TRUE(test, test_bit(7, smmu->context_map));
+	KUNIT_EXPECT_TRUE(test, test_bit(15, smmu->context_map));
+	for (i = 0; i < T_GROUPS; i++) {
+		u32 s2cr = t_r32(w->buf, ARM_SMMU_GR0_S2CR(i));
+
+		if (!(t_r32(w->buf, ARM_SMMU_GR0_SMR(i)) & ARM_SMMU_SMR_VALID) ||
+		    FIELD_GET(ARM_SMMU_S2CR_TYPE, s2cr) != S2CR_TYPE_TRANS)
+			continue;
+		KUNIT_EXPECT_NE(test, FIELD_GET(ARM_SMMU_S2CR_CBNDX, s2cr), 7);
+		KUNIT_EXPECT_NE(test, FIELD_GET(ARM_SMMU_S2CR_CBNDX, s2cr), 15);
+	}
+
+	/*
+	 * The rules with two IDs: neither entry can go back to its old bank,
+	 * and an inherited exact entry whose ID is not on the list (SME 30,
+	 * 0x1801) cannot be pointed at a new bank or rewritten.
+	 */
+	KUNIT_EXPECT_FALSE(test, t_wr_s2cr(smmu, T_QUP_SME, t_s2cr(S2CR_TYPE_TRANS, 7)));
+	KUNIT_EXPECT_FALSE(test, t_wr_s2cr(smmu, T_USB_SME, t_s2cr(S2CR_TYPE_TRANS, 15)));
+	KUNIT_EXPECT_FALSE(test, t_wr_s2cr(smmu, 30, t_s2cr(S2CR_TYPE_TRANS, cbq)));
+	KUNIT_EXPECT_FALSE(test, t_wr_smr(smmu, 30, t_smr(0x1801, 0)));
+	KUNIT_EXPECT_TRUE(test, t_wr_s2cr(smmu, T_QUP_SME, t_s2cr(S2CR_TYPE_TRANS, cbq)));
+	KUNIT_EXPECT_TRUE(test, t_wr_smr(smmu, T_QUP_SME, t_smr(T_QUP_SID, 0)));
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_refused), 4);
+
+	arm_smmu_inherit_test_detach(usb, du);
+	arm_smmu_inherit_test_detach(qup, dq);
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_refused), 4);
+}
