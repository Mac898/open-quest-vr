+		{ T_ID0 & ~ARM_SMMU_ID0_SMS, T_ID1 },	/* stream indexing */
+		{ T_ID0, T_ID1 | ARM_SMMU_ID1_PAGESIZE },	/* 64K pages */
+		{ T_ID0, (T_ID1 & ~ARM_SMMU_ID1_NUMPAGENDXB) | 7U << 28 },	/* 2 MiB SMMU */
+		{ T_ID0 | ARM_SMMU_ID0_NUMSMRG, T_ID1 },	/* 255 groups */
