+/* Stream map rules: take over an exact inherited entry or nothing */
+static void inherit_find_sme_takes_over_only(struct kunit *test)
+{
+	struct t_win *w = kunit_kzalloc(test, sizeof(*w), GFP_KERNEL);
+	struct arm_smmu_device *smmu;
+
+	KUNIT_ASSERT_NOT_NULL(test, w);
+	smmu = t_probe_smmu(test, w, T_ID0, T_ID1);
+	KUNIT_ASSERT_EQ(test, arm_smmu_inherit_test_cfg_probe(smmu), 0);
+
+	KUNIT_EXPECT_EQ(test, arm_smmu_inherit_test_find_sme(smmu, 0, 0), 10);
+	KUNIT_EXPECT_EQ(test, arm_smmu_inherit_test_find_sme(smmu, 0x1801, 0), 30);
+	/* masked inherited entry: a master would re-point its other IDs */
+	KUNIT_EXPECT_EQ(test, arm_smmu_inherit_test_find_sme(smmu, 0x1001, 0), -EPERM);
+	/* a mask wider than the entry's: the upstream overlap rule refuses it */
+	KUNIT_EXPECT_EQ(test, arm_smmu_inherit_test_find_sme(smmu, 0, 1), -EINVAL);
+	/* no inherited entry: never claim a free one */
+	KUNIT_EXPECT_EQ(test, arm_smmu_inherit_test_find_sme(smmu, 0x1234, 0), -EPERM);
+	KUNIT_EXPECT_EQ(test, memcmp(w->buf, w->copy, T_WIN), 0);
+}
