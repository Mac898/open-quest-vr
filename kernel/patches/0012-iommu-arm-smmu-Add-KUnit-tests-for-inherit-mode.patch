From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mac <xmachd@gmail.com>
Date: Tue, 20 Oct 2026 12:00:00 +0000
Subject: [PATCH 12/16] iommu/arm-smmu: Add KUnit tests for inherit mode

Test the inherit mode register access rules, the probe and the attach
and release paths on a fake register window with the Quest 2 apps SMMU
geometry, checking exactly which registers change. The tests need a few
hooks in arm-smmu.c, built only with the test.

Signed-off-by: mac <xmachd@gmail.com>
---
 drivers/iommu/arm/Kconfig                     |  13 +
 drivers/iommu/arm/arm-smmu/.kunitconfig       |   6 +
 drivers/iommu/arm/arm-smmu/Makefile           |   1 +
 .../arm/arm-smmu/arm-smmu-inherit-test.c      | 754 ++++++++++++++++++
 drivers/iommu/arm/arm-smmu/arm-smmu.c         |  86 ++
 drivers/iommu/arm/arm-smmu/arm-smmu.h         |  13 +
 6 files changed, 873 insertions(+)
 create mode 100644 drivers/iommu/arm/arm-smmu/.kunitconfig
 create mode 100644 drivers/iommu/arm/arm-smmu/arm-smmu-inherit-test.c

diff --git a/drivers/iommu/arm/Kconfig b/drivers/iommu/arm/Kconfig
index ef42bbe07..425e2d2dd 100644
--- a/drivers/iommu/arm/Kconfig
+++ b/drivers/iommu/arm/Kconfig
@@ -58,6 +58,19 @@ config ARM_SMMU_QCOM
 	  When running on a Qualcomm platform that has the custom variant
 	  of the ARM SMMU, this needs to be built into the SMMU driver.
 
+config ARM_SMMU_INHERIT_KUNIT_TEST
+	bool "KUnit tests for the arm-smmu inherit mode register rules" if !KUNIT_ALL_TESTS
+	depends on ARM_SMMU=y && KUNIT=y
+	default KUNIT_ALL_TESTS
+	help
+	  Tests arm_smmu_inherit_access_ok(), the check every register access
+	  makes in inherit mode (compatible
+	  "oculus,hollywood-apps-smmu-inherit"): no sCR0 or other global write,
+	  no access to inherited stream map entries or context banks, no S2CR
+	  of type BYPASS or FAULT.
+
+	  If unsure, say N.
+
 config ARM_SMMU_QCOM_DEBUG
 	bool "ARM SMMU QCOM implementation defined debug support"
 	depends on ARM_SMMU_QCOM=y
