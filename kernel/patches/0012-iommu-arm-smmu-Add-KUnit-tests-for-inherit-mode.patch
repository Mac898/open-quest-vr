+/*
+ * The attach path for a master @dev with one stream ID (@sid, mask 0), as
+ * the IOMMU core drives it after probe_device's checks: the stream map
+ * allocation, a paging domain, attach. @dev->iommu is set up here as the
+ * core would.
+ */
+struct iommu_domain *arm_smmu_inherit_test_attach(struct arm_smmu_device *smmu,
+						  struct device *dev, u32 sid,
+						  int *err)
+{
+	struct arm_smmu_master_cfg *cfg;
+	struct iommu_fwspec *fwspec;
+	struct iommu_domain *domain;
+
+	dev->iommu = kzalloc(sizeof(*dev->iommu), GFP_KERNEL);
+	fwspec = kzalloc(struct_size(fwspec, ids, 1), GFP_KERNEL);
+	cfg = kzalloc(struct_size(cfg, smendx, 1), GFP_KERNEL);
+	if (!dev->iommu || !fwspec || !cfg) {
+		kfree(dev->iommu);
+		dev->iommu = NULL;
+		kfree(fwspec);
+		kfree(cfg);
+		*err = -ENOMEM;
+		return NULL;
+	}
+	mutex_init(&dev->iommu->lock);
+	fwspec->num_ids = 1;
+	fwspec->ids[0] = FIELD_PREP(ARM_SMMU_SMR_ID, sid);
+	dev->iommu->fwspec = fwspec;
+	cfg->smmu = smmu;
+	cfg->smendx[0] = INVALID_SMENDX;
+	/* dev_iommu_priv_set() without iommu_probe_device_lock: test device */
+	dev->iommu->priv = cfg;
+
+	*err = arm_smmu_master_alloc_smes(dev);
+	if (*err)
+		return NULL;
+	domain = arm_smmu_domain_alloc_paging(dev);
+	if (!domain) {
+		*err = -ENOMEM;
+		return NULL;
+	}
+	*err = arm_smmu_attach_dev(domain, dev);
+	return domain;
+}
+
+/* The release path: the master lets go of its entries, its domain is freed */
+void arm_smmu_inherit_test_detach(struct device *dev,
+				  struct iommu_domain *domain)
+{
+	struct arm_smmu_master_cfg *cfg = dev_iommu_priv_get(dev);
+	struct iommu_fwspec *fwspec = dev_iommu_fwspec_get(dev);
+
+	if (cfg && fwspec)
+		arm_smmu_master_free_smes(cfg, fwspec);
+	if (domain)
+		arm_smmu_domain_free(domain);
+	kfree(cfg);
+	kfree(fwspec);
+	kfree(dev->iommu);
+	dev->iommu = NULL;
+}
