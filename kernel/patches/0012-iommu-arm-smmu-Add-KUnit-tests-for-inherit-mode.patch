diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu-inherit-test.c b/drivers/iommu/arm/arm-smmu/arm-smmu-inherit-test.c
new file mode 100644
index 000000000..7f523424b
--- /dev/null
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-inherit-test.c
@@ -0,0 +1,754 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for the arm-smmu inherit mode register rules
+ * (arm_smmu_inherit_access_ok()).
+ *
+ * The fake SMMU has the Quest 2 apps SMMU geometry (87 stream map groups,
+ * 74 context banks, 4K pages, 128-page halves) with entries 0-65 valid
+ * and banks 0-48 in use, as the inherit probe would seed it. Stream IDs
+ * in it are made up.
+ *
+ * The probe tests run arm_smmu_inherit_cfg_probe() and the dump on a fake
+ * 1 MiB register window in memory, with the ID0/ID1 values of the Quest 2
+ * apps SMMU, and check that the window is byte-identical afterwards. The
+ * attach tests run the real attach and release paths on that window and
+ * check which registers changed.
+ */
+#include <kunit/device.h>
+#include <kunit/test.h>
+#include <linux/bitfield.h>
+#include <linux/interrupt.h>
+#include <linux/iommu.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+
+#include "arm-smmu.h"
+
+#define T_GROUPS	87
+#define T_CBS		74
+#define T_NPAGE		128
+#define T_LIVE_SMES	66
+#define T_LIVE_CBS	49
+#define T_USB_SME	10	/* inherited entry with ID 0, mask 0 */
+#define T_FREE_CB	60
+
+struct t_smmu {
+	struct arm_smmu_device smmu;
+	struct arm_smmu_smr smrs[T_GROUPS];
+	u32 sid;
+};
+
+static struct arm_smmu_device *t_smmu(struct kunit *test, bool attach)
+{
+	struct t_smmu *t = kunit_kzalloc(test, sizeof(*t), GFP_KERNEL);
+	struct arm_smmu_device *smmu;
+	int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, t);
+	smmu = &t->smmu;
+	smmu->dev = kunit_device_register(test, "arm-smmu-inherit-test");
+	KUNIT_ASSERT_FALSE(test, IS_ERR(smmu->dev));
+	smmu->inherit = true;
+	smmu->num_mapping_groups = T_GROUPS;
+	smmu->num_context_banks = T_CBS;
+	smmu->numpage = T_NPAGE;
+	smmu->pgshift = 12;
+	smmu->smrs = t->smrs;
+
+	for (i = 0; i < T_LIVE_SMES; i++) {
+		t->smrs[i].valid = true;
+		t->smrs[i].id = 0x100 + i;
+		set_bit(i, smmu->inherit_smes);
+	}
+	t->smrs[T_USB_SME].id = 0;
+	for (i = 0; i < T_LIVE_CBS; i++) {
+		set_bit(i, smmu->context_map);
+		set_bit(i, smmu->inherit_cbs);
+	}
+
+	if (attach) {
+		t->sid = 0;
+		smmu->inherit_sids = &t->sid;
+		smmu->num_inherit_sids = 1;
+		smmu->inherit_attach = true;
+	}
+	return smmu;
+}
+
+static bool t_rd(struct arm_smmu_device *smmu, int page, int offset)
+{
+	return arm_smmu_inherit_access_ok(smmu, page, offset, false, 0);
+}
+
+static bool t_wr(struct arm_smmu_device *smmu, int page, int offset, u64 val)
+{
+	return arm_smmu_inherit_access_ok(smmu, page, offset, true, val);
+}
+
+static bool t_wr_smr(struct arm_smmu_device *smmu, int n, u32 val)
+{
+	return t_wr(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_SMR(n), val);
+}
+
+static bool t_wr_s2cr(struct arm_smmu_device *smmu, int n, u32 val)
+{
+	return t_wr(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_S2CR(n), val);
+}
+
+static u32 t_s2cr(u32 type, u32 cbndx)
+{
+	return FIELD_PREP(ARM_SMMU_S2CR_TYPE, type) |
+	       FIELD_PREP(ARM_SMMU_S2CR_CBNDX, cbndx);
+}
+
+static u32 t_smr(u16 id, u16 mask)
+{
+	return ARM_SMMU_SMR_VALID | FIELD_PREP(ARM_SMMU_SMR_ID, id) |
+	       FIELD_PREP(ARM_SMMU_SMR_MASK, mask);
+}
+
+/* The global registers the reset path writes: never, in either mode */
+static const int t_global[] = {
+	ARM_SMMU_GR0_sCR0, ARM_SMMU_GR0_sACR, ARM_SMMU_GR0_sGFSR,
+	ARM_SMMU_GR0_TLBIVMID, ARM_SMMU_GR0_TLBIALLNSNH, ARM_SMMU_GR0_TLBIALLH,
+	ARM_SMMU_GR0_sTLBGSYNC,
+};
+
+static void t_global_refused(struct kunit *test, struct arm_smmu_device *smmu)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(t_global); i++) {
+		KUNIT_EXPECT_FALSE_MSG(test, t_wr(smmu, ARM_SMMU_GR0, t_global[i], 0),
+				       "global write %#x", t_global[i]);
+		KUNIT_EXPECT_FALSE_MSG(test, t_rd(smmu, ARM_SMMU_GR0, t_global[i]),
+				       "global read %#x", t_global[i]);
+	}
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_sGFSYNR0));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_sTLBGSTATUS));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_ID7));
+}
+
+static void inherit_reads_without_masters(struct kunit *test)
+{
+	struct arm_smmu_device *smmu = t_smmu(test, false);
+
+	KUNIT_EXPECT_TRUE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_ID0));
+	KUNIT_EXPECT_TRUE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_ID1));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_ID2));
+	KUNIT_EXPECT_TRUE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_SMR(0)));
+	KUNIT_EXPECT_TRUE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_SMR(T_GROUPS - 1)));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_SMR(T_GROUPS)));
+	/* S2CR only behind a valid SMR */
+	KUNIT_EXPECT_TRUE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_S2CR(0)));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_S2CR(T_LIVE_SMES)));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_SMR(0) + 2));
+	/* no context bank or GR1 access at all */
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_GR1, ARM_SMMU_GR1_CBAR(13)));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_GR1, ARM_SMMU_GR1_CBAR(T_FREE_CB)));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_CB(smmu, 13), ARM_SMMU_CB_SCTLR));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_CB(smmu, T_FREE_CB), ARM_SMMU_CB_FSR));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, 2, 0));
+	t_global_refused(test, smmu);
+}
+
+static void inherit_no_writes_without_masters(struct kunit *test)
+{
+	struct arm_smmu_device *smmu = t_smmu(test, false);
+	int refused;
+
+	set_bit(T_FREE_CB, smmu->context_map);
+	clear_bit(T_USB_SME, smmu->inherit_smes);
+	refused = atomic_read(&smmu->inherit_refused);
+
+	KUNIT_EXPECT_FALSE(test, t_wr_smr(smmu, T_USB_SME, t_smr(0, 0)));
+	KUNIT_EXPECT_FALSE(test, t_wr_s2cr(smmu, T_USB_SME, t_s2cr(S2CR_TYPE_TRANS, T_FREE_CB)));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_GR1, ARM_SMMU_GR1_CBAR(T_FREE_CB), 0));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_CB(smmu, T_FREE_CB), ARM_SMMU_CB_SCTLR, 0));
+	t_global_refused(test, smmu);
+
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_writes), 0);
+	KUNIT_EXPECT_GT(test, atomic_read(&smmu->inherit_refused), refused);
+}
+
+static void inherit_writes_with_master(struct kunit *test)
+{
+	struct arm_smmu_device *smmu = t_smmu(test, true);
+
+	KUNIT_EXPECT_TRUE(test, t_rd(smmu, ARM_SMMU_GR0, ARM_SMMU_GR0_ID2));
+
+	/* the USB entry is still inherited: nothing may touch it */
+	KUNIT_EXPECT_FALSE(test, t_wr_s2cr(smmu, T_USB_SME, t_s2cr(S2CR_TYPE_TRANS, T_FREE_CB)));
+
+	/* taken over, bank T_FREE_CB allocated */
+	clear_bit(T_USB_SME, smmu->inherit_smes);
+	set_bit(T_FREE_CB, smmu->context_map);
+
+	KUNIT_EXPECT_TRUE(test, t_wr_s2cr(smmu, T_USB_SME, t_s2cr(S2CR_TYPE_TRANS, T_FREE_CB)));
+	KUNIT_EXPECT_FALSE(test, t_wr_s2cr(smmu, T_USB_SME, t_s2cr(S2CR_TYPE_BYPASS, 0xff)));
+	KUNIT_EXPECT_FALSE(test, t_wr_s2cr(smmu, T_USB_SME, t_s2cr(S2CR_TYPE_FAULT, 0)));
+	KUNIT_EXPECT_FALSE(test, t_wr_s2cr(smmu, T_USB_SME, t_s2cr(S2CR_TYPE_TRANS, 15)));
+	KUNIT_EXPECT_FALSE(test, t_wr_s2cr(smmu, T_USB_SME,
+					   t_s2cr(S2CR_TYPE_TRANS, T_FREE_CB + 1)));
+	KUNIT_EXPECT_FALSE(test, t_wr_s2cr(smmu, T_USB_SME + 1,
+					   t_s2cr(S2CR_TYPE_TRANS, T_FREE_CB)));
+
+	KUNIT_EXPECT_TRUE(test, t_wr_smr(smmu, T_USB_SME, t_smr(0, 0)));
+	KUNIT_EXPECT_FALSE(test, t_wr_smr(smmu, T_USB_SME, 0));
+	KUNIT_EXPECT_FALSE(test, t_wr_smr(smmu, T_USB_SME, t_smr(0, 1)));
+	KUNIT_EXPECT_FALSE(test, t_wr_smr(smmu, T_USB_SME, t_smr(5, 0)));
+	KUNIT_EXPECT_FALSE(test, t_wr_smr(smmu, T_USB_SME + 1, t_smr(0, 0)));
+
+	/* the owned bank only */
+	KUNIT_EXPECT_TRUE(test, t_wr(smmu, ARM_SMMU_CB(smmu, T_FREE_CB), ARM_SMMU_CB_SCTLR, 1));
+	KUNIT_EXPECT_TRUE(test, t_rd(smmu, ARM_SMMU_CB(smmu, T_FREE_CB), ARM_SMMU_CB_FSR));
+	KUNIT_EXPECT_TRUE(test, t_wr(smmu, ARM_SMMU_GR1, ARM_SMMU_GR1_CBAR(T_FREE_CB), 0));
+	KUNIT_EXPECT_TRUE(test, t_wr(smmu, ARM_SMMU_GR1, ARM_SMMU_GR1_CBA2R(T_FREE_CB), 1));
+	KUNIT_EXPECT_TRUE(test, t_rd(smmu, ARM_SMMU_GR1, ARM_SMMU_GR1_CBFRSYNRA(T_FREE_CB)));
+	/* ... and of it only the registers the attach, TLB and fault paths use */
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_GR1, ARM_SMMU_GR1_CBAR(T_FREE_CB)));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_GR1, ARM_SMMU_GR1_CBFRSYNRA(T_FREE_CB), 0));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_GR1, ARM_SMMU_GR1_CBA2R(0) + 0x400, 0));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_CB(smmu, T_FREE_CB), ARM_SMMU_CB_SCTLR));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_CB(smmu, T_FREE_CB), ARM_SMMU_CB_ACTLR, 0));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_CB(smmu, T_FREE_CB),
+				      ARM_SMMU_CB_CONTEXTIDR, 0));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_CB(smmu, T_FREE_CB), ARM_SMMU_CB_ATS1PR, 0));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_CB(smmu, T_FREE_CB), ARM_SMMU_CB_ATSR));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_CB(smmu, T_FREE_CB), ARM_SMMU_CB_PAR));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_CB(smmu, T_FREE_CB),
+				      ARM_SMMU_CB_S2_TLBIIPAS2, 0));
+	/* a free bank nobody allocated */
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_CB(smmu, T_FREE_CB + 1),
+				      ARM_SMMU_CB_SCTLR, 0));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_GR1, ARM_SMMU_GR1_CBAR(T_FREE_CB + 1), 0));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_CB(smmu, 13), ARM_SMMU_CB_SCTLR, 0));
+	KUNIT_EXPECT_FALSE(test, t_rd(smmu, ARM_SMMU_CB(smmu, 0), ARM_SMMU_CB_SCTLR));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_CB(smmu, 48), ARM_SMMU_CB_S1_TLBIASID, 0));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_GR1, ARM_SMMU_GR1_CBAR(13), 0));
+	KUNIT_EXPECT_FALSE(test, t_wr(smmu, ARM_SMMU_CB(smmu, T_CBS), ARM_SMMU_CB_SCTLR, 0));
+
+	t_global_refused(test, smmu);
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_writes), 5);
+}
+
+/* Through the real accessor: a refused write must not reach MMIO (base is NULL) */
+static void inherit_accessor_refuses_scr0(struct kunit *test)
+{
+	struct arm_smmu_device *smmu = t_smmu(test, true);
+
+	smmu->base = NULL;
+	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_sCR0, ARM_SMMU_sCR0_CLIENTPD);
+	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_sGFSR, ~0U);
+	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_TLBIALLNSNH, ~0U);
+	arm_smmu_cb_write(smmu, 13, ARM_SMMU_CB_SCTLR, 0);
+	arm_smmu_cb_writeq(smmu, 15, ARM_SMMU_CB_TTBR0, 0);
+	KUNIT_EXPECT_EQ(test, arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_sCR0), 0);
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_writes), 0);
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_refused), 6);
+}
+
+#define T_WIN		SZ_1M
+#define T_ID0		0x4c017e57	/* 87 groups, 15-bit IDs, no EXIDS */
+#define T_ID1		0x6000004a	/* 74 banks, 4K pages, 128-page halves */
+
+struct t_win {
+	void *buf;
+	void *copy;
+};
+
+static void t_win_free(void *data)
+{
+	struct t_win *w = data;
+
+	vfree(w->buf);
+	vfree(w->copy);
+}
+
+static void t_w32(void *buf, unsigned long off, u32 val)
+{
+	*(u32 *)(buf + off) = val;
+}
+
+/* Probe-time state: a window with SMEs at 0, 10, 20, 30 (TRANS) and 40 (not TRANS) */
+static struct arm_smmu_device *t_probe_smmu(struct kunit *test, struct t_win *w,
+					    u32 id0, u32 id1)
+{
+	struct arm_smmu_device *smmu = kunit_kzalloc(test, sizeof(*smmu), GFP_KERNEL);
+	void *b;
+
+	KUNIT_ASSERT_NOT_NULL(test, smmu);
+	w->buf = vzalloc(T_WIN);
+	w->copy = vzalloc(T_WIN);
+	KUNIT_ASSERT_NOT_NULL(test, w->buf);
+	KUNIT_ASSERT_NOT_NULL(test, w->copy);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, t_win_free, w), 0);
+	b = w->buf;
+
+	t_w32(b, ARM_SMMU_GR0_ID0, id0);
+	t_w32(b, ARM_SMMU_GR0_ID1, id1);
+	t_w32(b, ARM_SMMU_GR0_SMR(0), t_smr(0x4a0, 0));
+	t_w32(b, ARM_SMMU_GR0_S2CR(0), t_s2cr(S2CR_TYPE_TRANS, 0));
+	t_w32(b, ARM_SMMU_GR0_SMR(10), t_smr(0, 0));
+	t_w32(b, ARM_SMMU_GR0_S2CR(10), t_s2cr(S2CR_TYPE_TRANS, 15) | 0x300);
+	t_w32(b, ARM_SMMU_GR0_SMR(20), t_smr(0x1001, 0x460));
+	t_w32(b, ARM_SMMU_GR0_S2CR(20), t_s2cr(S2CR_TYPE_TRANS, 31));
+	t_w32(b, ARM_SMMU_GR0_SMR(30), t_smr(0x1801, 0));
+	t_w32(b, ARM_SMMU_GR0_S2CR(30), t_s2cr(S2CR_TYPE_TRANS, 48));
+	t_w32(b, ARM_SMMU_GR0_SMR(40), t_smr(0x2101, 0x404));
+	t_w32(b, ARM_SMMU_GR0_S2CR(40), t_s2cr(S2CR_TYPE_FAULT, 0));
+	/* an invalid SMR with a stale S2CR: must not be read or seeded */
+	t_w32(b, ARM_SMMU_GR0_S2CR(50), t_s2cr(S2CR_TYPE_TRANS, 60));
+	/* CB15: translating, TTBR0 with a low ASID (cbndx + 1) */
+	t_w32(b, ((T_NPAGE + 15) << 12) + ARM_SMMU_CB_SCTLR, 1);
+	t_w32(b, ((T_NPAGE + 15) << 12) + ARM_SMMU_CB_TTBR0, 0xdcb10000);
+	t_w32(b, ((T_NPAGE + 15) << 12) + ARM_SMMU_CB_TTBR0 + 4, 16 << 16 | 0x1);
+	memcpy(w->copy, b, T_WIN);
+
+	static atomic_t seq = ATOMIC_INIT(0);
+	char *name = kunit_kzalloc(test, 40, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, name);
+	snprintf(name, 40, "arm-smmu-inherit-probe-%d", atomic_inc_return(&seq));
+	smmu->dev = kunit_device_register(test, name);
+	KUNIT_ASSERT_FALSE(test, IS_ERR(smmu->dev));
+	smmu->base = b;
+	smmu->numpage = T_WIN;
+	smmu->version = ARM_SMMU_V2;
+	smmu->num_context_irqs = 96;
+	smmu->inherit = true;
+	return smmu;
+}
+
+static void inherit_probe_seeds_and_writes_nothing(struct kunit *test)
+{
+	struct t_win *w = kunit_kzalloc(test, sizeof(*w), GFP_KERNEL);
+	struct arm_smmu_device *smmu;
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, w);
+	smmu = t_probe_smmu(test, w, T_ID0, T_ID1);
+
+	KUNIT_ASSERT_EQ(test, arm_smmu_inherit_test_cfg_probe(smmu), 0);
+	KUNIT_EXPECT_EQ(test, arm_smmu_inherit_test_dump(smmu), 0);
+
+	KUNIT_EXPECT_EQ(test, smmu->num_mapping_groups, 87);
+	KUNIT_EXPECT_EQ(test, smmu->num_context_banks, 74);
+	KUNIT_EXPECT_EQ(test, smmu->numpage, T_NPAGE);
+	KUNIT_EXPECT_EQ(test, smmu->pgshift, 12);
+	KUNIT_EXPECT_EQ(test, smmu->streamid_mask, 0x7fff);
+	KUNIT_EXPECT_EQ(test, smmu->smr_mask_mask, 0x7fff);
+	KUNIT_EXPECT_FALSE(test, smmu->features & ARM_SMMU_FEAT_EXIDS);
+	/* no master: no page-table format, so no domain can be built */
+	KUNIT_EXPECT_EQ(test, smmu->pgsize_bitmap, 0);
+	KUNIT_EXPECT_EQ(test, smmu->features & ARM_SMMU_FEAT_FMT_AARCH64_4K, 0);
+
+	for (i = 0; i < T_CBS; i++) {
+		bool live = i == 0 || i == 15 || i == 31 || i == 48;
+
+		KUNIT_EXPECT_EQ_MSG(test, test_bit(i, smmu->context_map), live, "CB%u", i);
+		KUNIT_EXPECT_EQ_MSG(test, test_bit(i, smmu->inherit_cbs), live, "CB%u", i);
+	}
+	for (i = 0; i < 87; i++) {
+		bool live = i == 0 || i == 10 || i == 20 || i == 30 || i == 40;
+
+		KUNIT_EXPECT_EQ_MSG(test, test_bit(i, smmu->inherit_smes), live, "SME%u", i);
+		KUNIT_EXPECT_EQ_MSG(test, smmu->smrs[i].valid, live, "SME%u", i);
+		if (live)
+			KUNIT_EXPECT_EQ(test, smmu->s2crs[i].count, 1);
+	}
+	KUNIT_EXPECT_EQ(test, smmu->s2crs[10].cbndx, 15);
+	KUNIT_EXPECT_EQ(test, smmu->s2crs[10].type, S2CR_TYPE_TRANS);
+	KUNIT_EXPECT_EQ(test, smmu->smrs[20].id, 0x1001);
+	KUNIT_EXPECT_EQ(test, smmu->smrs[20].mask, 0x460);
+	KUNIT_EXPECT_EQ(test, smmu->s2crs[40].type, S2CR_TYPE_FAULT);
+	KUNIT_EXPECT_FALSE(test, test_bit(60, smmu->context_map));
+
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_writes), 0);
+	KUNIT_EXPECT_EQ(test, atomic_read(&smmu->inherit_refused), 0);
+	KUNIT_EXPECT_EQ(test, memcmp(w->buf, w->copy, T_WIN), 0);
+}
