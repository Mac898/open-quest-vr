+/*
+ * Not reserved on this board: the vendor kernel uses this range as System RAM,
+ * and the kernel is loaded at 0x90000000.
+ */
+/delete-node/ &cdsp_secure_heap;
+
+/ {
+	model = "Oculus Quest 2 (hollywood)";
+	compatible = "oculus,hollywood", "qcom,sm8250";
+	chassis-type = "embedded";
+
+	/* bootargs and linux,initrd-* are filled in by the boot loader */
+	chosen { };
+
+	/* 6 GiB, as passed by the bootloader */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x3cc00000>,
+		      <0x0 0xc0000000 0x0 0x80000000>,
+		      <0x1 0x40000000 0x0 0xc0000000>;
+	};
+
+	/*
+	 * All no-map, so that the no-map regions the boot loader adds at run
+	 * time may overlap them.
+	 */
+	reserved-memory {
+		xbl_uefi_log_mem: memory@80880000 {
+			reg = <0x0 0x80880000 0x0 0x14000>;
+			no-map;
+		};
+
+		/*
+		 * Android's ramoops region (0x9ba00000, 0x90000). The first
+		 * 256 KiB hold Android's dump records and the boot loader's RAM
+		 * log and are left alone; the console and pmsg zones are
+		 * reused.
+		 */
+		android_ramoops_dump_mem: memory@9ba00000 {
+			reg = <0x0 0x9ba00000 0x0 0x40000>;
+			no-map;
+		};
+
+		ramoops@9ba40000 {
+			compatible = "ramoops";
+			reg = <0x0 0x9ba40000 0x0 0x50000>;
+			record-size = <0x10000>;
+			console-size = <0x20000>;
+			pmsg-size = <0x20000>;
+			no-map;
+		};
+
+		/* Android's splash framebuffer; MDSS may still scan it out */
+		cont_splash_mem: memory@9c000000 {
+			reg = <0x0 0x9c000000 0x0 0x2300000>;
+			no-map;
+		};
+
+		dfps_data_mem: memory@9e300000 {
+			reg = <0x0 0x9e300000 0x0 0x100000>;
+			no-map;
+		};
+
+		/*
+		 * Android's DMA/CMA pools and mailbox region. The remote
+		 * processors and TZ keep running and may still DMA into them.
+		 */
+		android_dyn_pools_mem: memory@ec800000 {
+			reg = <0x0 0xec800000 0x0 0x13420000>;
+			no-map;
+		};
+	};
+
+	/*
+	 * The vendor kernel controls the fan speed in closed loop. pwm-fan uses
+	 * just two duty values, the vendor start value (84) and full speed, so
+	 * the fan never stops.
+	 */
+	fan: fan {
+		compatible = "pwm-fan";
+		pwms = <&pm8150l_lpg 4 40000>;
+		fan-supply = <&vreg_bob>;
+		interrupts-extended = <&tlmm 64 IRQ_TYPE_EDGE_RISING>;
+		pulses-per-revolution = <2>;
+		cooling-levels = <84 255>;
+		#cooling-cells = <2>;
+		/* Keep full speed across kexec and reboot */
+		fan-shutdown-percent = <100>;
+
+		pinctrl-0 = <&fan_pwm_default>, <&fan_tach_default>;
+		pinctrl-names = "default";
+	};
+
