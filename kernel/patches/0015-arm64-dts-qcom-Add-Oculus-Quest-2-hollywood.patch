+/*
+ * Bound in inherit mode: the stream map and context banks set up by Android and
+ * the secure world are kept and the SMMU is never reset. The compatible
+ * replaces the generic ones so that no other driver binds the node.
+ *
+ * USB (stream 0x0) and the QUP2 wrapper (stream 0x63) take over their inherited
+ * entries and get new context banks; the banks they leave (CB15, CB7) stay
+ * reserved. Table walks are non-coherent, as Android set up.
+ */
+&apps_smmu {
+	compatible = "oculus,hollywood-apps-smmu-inherit";
+	oculus,inherit-attach-sids = <0x0 0x63>;
+	/delete-property/ dma-coherent;
+	status = "okay";
+};
