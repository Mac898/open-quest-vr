+ * Oculus Quest 2 ("hollywood"), Qualcomm XR2 / SM8250.
+ *
+ * Linux is started from the stock Android system by kexec. Android, the secure
+ * world and the remote processors keep much of the hardware running across that
+ * handoff, so only what this port drives is enabled and the rest is left as
+ * Android set it up.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/leds/common.h>
