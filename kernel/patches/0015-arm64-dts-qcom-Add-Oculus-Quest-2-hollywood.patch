+/*
+ * Mainline reads the configuration of every valid GPIO at registration, and an
+ * access to a TZ-owned pin is an XPU violation. The TZ-owned set is not known,
+ * so all pins are reserved except those the vendor kernel uses: gpio0-3 (SE19
+ * SPI), gpio4/5 (syncboss ready and reset), gpio8/9 (SE4 I2C) and gpio64 (fan
+ * tach).
+ */
+&tlmm {
+	gpio-reserved-ranges = <6 2>, <10 54>, <65 116>;
+
+	fan_tach_default: fan-tach-default-state {
+		pins = "gpio64";
+		function = "gpio";
+		drive-strength = <4>;
+		bias-pull-up;
+	};
+
+	syncboss_ready_default: syncboss-ready-default-state {
+		pins = "gpio4";
+		function = "gpio";
+		bias-pull-down;
+	};
+
+	syncboss_reset_default: syncboss-reset-default-state {
+		pins = "gpio5";
+		function = "gpio";
+		drive-strength = <6>;
+		output-low;
+	};
+};
+
+&qup_spi19_cs {
+	drive-strength = <6>;
+	bias-disable;
+};
+
+&qup_spi19_data_clk {
+	drive-strength = <6>;
+	bias-disable;
+};
+
+/*
+ * USB 2.0 only: the QMP combo PHY is left as Android set it up and dwc3 uses
+ * the UTMI clock as PIPE clock, like the other HS-only SM8250 boards.
+ */
+&usb_1 {
+	qcom,select-utmi-as-pipe-clk;
+
+	status = "okay";
+};
+
+&usb_1_dwc3 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	phys = <&usb_1_hsphy>;
+	phy-names = "usb2-phy";
+};
+
+&usb_1_hsphy {
+	vdda-pll-supply = <&vreg_l5a_0p88>;
+	vdda18-supply = <&vreg_l12a_1p8>;
+	vdda33-supply = <&vreg_l2a_3p072>;
+
+	status = "okay";
+};
+
+/* SS PHY not used (HS only); left untouched */
+&usb_1_qmpphy {
+	vdda-phy-supply = <&vreg_l9a_1p2>;
+	vdda-pll-supply = <&vreg_l18a_0p912>;
+
+	status = "disabled";
+};
+
+/* SE4 only; the wrapper is not attached to the apps SMMU */
+&qupv3_id_0 {
+	/delete-property/ iommus;
+
+	status = "okay";
+};
+
+/*
+ * FIFO mode only. No qup-memory path: it starts on aggre2_noc, which stays
+ * disabled.
+ */
+&i2c4 {
+	clock-frequency = <100000>;
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+	/delete-property/ power-domains;
+	interconnects = <&qup_virt MASTER_QUP_CORE_0 0 &qup_virt SLAVE_QUP_CORE_0 0>,
+			<&gem_noc MASTER_AMPSS_M0 0 &config_noc SLAVE_QUP_0 0>;
+	interconnect-names = "qup-core",
+			     "qup-config";
+
+	status = "okay";
+
+	/*
+	 * No monitored-battery, so the driver never writes the gauge's data
+	 * memory
+	 */
+	fuel-gauge@55 {
+		compatible = "ti,bq27z561";
+		reg = <0x55>;
+	};
+};
+
+/*
+ * SE19 only. The wrapper (stream 0x63) is the SE DMA master and attaches to
+ * apps_smmu.
+ */
+&qupv3_id_2 {
+	status = "okay";
+};
+
+/* FIFO, and SE DMA for long transfers; no GPI DMA */
+&spi19 {
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+	/delete-property/ power-domains;
+	/delete-property/ operating-points-v2;
+
+	pinctrl-0 = <&qup_spi19_data_clk>, <&qup_spi19_cs>;
+	pinctrl-names = "default";
+
+	status = "okay";
+
+	/*
+	 * The vendor swd@0 (MCU programming), powerstate@0 and nsync@0 children
+	 * are deliberately left out.
+	 */
+	mcu@0 {
+		compatible = "oculus,hollywood-syncboss";
+		reg = <0>;
+		spi-max-frequency = <8000000>;
+		spi-cpol;
+		spi-cpha;
+		/* gpio4 -> PDC pin 107 (pinctrl-sm8250.c wakeirq map) */
+		interrupts-extended = <&tlmm 4 IRQ_TYPE_EDGE_RISING>;
+		ready-gpios = <&tlmm 4 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&tlmm 5 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&vreg_s4a_1p8>;
+		imu-supply = <&vreg_l7c_3p0>;
+		mag-supply = <&vreg_l8c_1p8>;
+
+		pinctrl-0 = <&syncboss_reset_default>, <&syncboss_ready_default>;
+		pinctrl-names = "default";
+	};
+};
