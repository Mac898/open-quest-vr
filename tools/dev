    (r"\bdd\b[^;|&]*\bof=", "dd with of= (write)"),
    (r"\b(mkfs|mke2fs|mkswap|fdisk|sfdisk|gdisk|sgdisk|parted|blkdiscard|wipefs|tune2fs|resize2fs|fsck)\b", "filesystem/partition tool"),
    (r"\b(flash_erase|flashcp|nandwrite|mtd_debug|ubiformat|fastboot)\b", "flash tool"),
    (r">>?\s*\S*/dev/(block|sd|mmcblk|ufs|mtd|disk)", "redirect into a block device"),
    (r"/dev/(mem|kmem)\b", "/dev/mem access (secure memory hazard)"),
    (r"\bdevmem\b", "devmem (secure memory hazard)"),
    (r"\bmount\b[^;|&]*/dev/(block|sd|mmcblk)", "mounting device storage"),
    (r"(swd|syncboss|nrf)[^;|&]*(flash|program|fw_?update|update_?fw|firmware)", "MCU programming"),
    (r">>?\s*\S*(syncboss|swd|nrf)", "write into syncboss/SWD/nRF interface"),
    (r"(\bblu\b|blu_|blu-|ttyHS13)[^;|&]*(flash|program|fw_?update|update_?fw|firmware)", "display BLU MCU programming"),
