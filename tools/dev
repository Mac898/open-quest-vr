    (r"\bupdate_firmware\b", "MCU firmware update attribute"),
    (r"(syncboss\w*|spi1\.0)/swd\b", "syncboss SWD interface (never touch)"),
    (r"swd@\d|:swd\b|\bupdate_status\b", "syncboss SWD device node / update_status (never touch)"),
    (r">>?\s*\S*/spi1\.0/\S*", "write into the syncboss SPI device's sysfs (control/reset etc.)"),  # = SB_WHY_DENY
    (r"\bttyHS14\b", "syncboss-side UART (never touch)"),
    (r"/dev/syncboss_powerstate", "syncboss powerstate (sends prox calibration to the MCU; never touch)"),
    (r"\b(i2cset|i2ctransfer|setpci|watchdog|wdctl|rtcwake|hwclock|fbset|stty|spidev_test)\b", "hardware-state write tool"),
