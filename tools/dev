    (r"\bqkx-(launch|switch)", "qkx-launch / qkx-switch (makes PID 1 switch_root)"),
    (r"/dev/watchdog", "/dev/watchdog* (opening it can arm a hardware watchdog)"),
    (r"\bi2cdetect\b(?!\s+-[lV](?=[\s;|&'\"]|$))", "i2cdetect bus probing (only -l / -V)"),
    (r"\blspci\b(?!\s+(--version|-n)(?=\s*($|[;|&'\"])))", "lspci config-space reads (only --version / -n)"),
]
# Any block-device path is refused unless the whole command is a plain `ls`: too many writers to list.
BLOCKDEV = re.compile(r"/dev/(block\b|sd[a-z]|mmcblk|ufs|mtd|disk\b)")
