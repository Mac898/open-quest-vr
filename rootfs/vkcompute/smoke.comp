// Headless Vulkan compute smoke: out[i] = f(i), checked on the CPU (vk_compute_smoke.c).
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Out { uint v[]; } o;
layout(push_constant) uniform P { uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint x = i * 2654435761u;
    for (int k = 0; k < 16; k++) x = (x ^ (x >> 13)) * 1103515245u + 12345u;
    o.v[i] = x;
}
